.split-layout { display: flex; height: 100vh; }
.placeholder-panel { flex: 1; background-color: #0a0a0a; display: flex; align-items: center; justify-content: center; border-right: 1px solid #333; }
.placeholder-box { text-align: center; padding: 2rem; border: 2px dashed #333; border-radius: 12px; color: #555; }
.placeholder-box h2 { margin-bottom: 0.5rem; color: #777; }
.dashboard-panel { flex: 1; padding: 2rem; overflow-y: auto; background-color: #181818; display: flex; flex-direction: column; gap: 2rem; }
.dashboard-panel h1 { font-size: 1.8rem; font-weight: 600; }

@media (max-width: 768px) {
    .split-layout { flex-direction: column; }
    .placeholder-panel { border-right: none; border-bottom: 1px solid #333; padding: 2rem; }
    .dashboard-panel { padding: 1.5rem; }
}
